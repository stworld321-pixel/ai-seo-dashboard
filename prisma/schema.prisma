// AI SEO Command Center — data model
// See docs/03-database-schema.md for the rationale behind each group.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs live in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Tenancy ───────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members  OrgMember[]
  websites Website[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  image        String?
  isAdmin      Boolean  @default(false)
  role         String   @default("USER")
  plan         String   @default("STARTER")
  status       String   @default("ACTIVE")
  phone        String?
  // Written by the register route and read by src/server/services/credits.ts.
  creditsRemaining Int  @default(5000)
  creditsTotal     Int  @default(5000)
  createdAt    DateTime @default(now())

  memberships OrgMember[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model OrgMember {
  id     String @id @default(cuid())
  orgId  String
  userId String
  role   Role   @default(MEMBER)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

// ─────────────────────── Website = SEO project ───────────────────────

enum CmsType {
  WORDPRESS
  SHOPIFY
  WEBFLOW
  NEXTJS
  REACT
  LARAVEL
  CUSTOM
  OTHER
}

model Website {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  url             String
  cms             CmsType  @default(CUSTOM)
  sitemapUrl      String?
  robotsUrl       String?
  timezone        String   @default("Asia/Kolkata")
  country         String   @default("IND")
  language        String   @default("en")
  automationLevel Int      @default(2) // 1..5, see docs/06
  gscProperty     String?
  ga4PropertyId   String?
  technology      String?
  framework       String?
  hosting         String?
  faviconUrl      String?
  publishingType  String   @default("none") // none | wordpress | shopify | github | webhook | manual
  lastCrawledAt   DateTime?
  lastGscSyncAt   DateTime?
  lastGa4SyncAt   DateTime?
  createdAt       DateTime @default(now())

  org               Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integrations      Integration[]
  gscDaily          GscDaily[]
  gscQueryDaily     GscQueryDaily[]
  gscPageDaily      GscPageDaily[]
  gscQueryPageDaily GscQueryPageDaily[]
  gscDimensionDaily GscDimensionDaily[]
  syncCursors       SyncCursor[]
  keywords          Keyword[]
  pages             PageRecord[]
  content           Content[]
  opportunities     Opportunity[]
  issues            SeoIssue[]
  healthSnapshots   HealthScoreSnapshot[]
  linkSuggestions   InternalLinkSuggestion[]
  tasks             AgentTask[]
  logs              AgentLog[]
  automationRules   AutomationRule[]
  automationRuns    AutomationRun[]
  approvals         Approval[]
  experiments       ContentExperiment[]
  learningSignals   LearningSignal[]
  notifications     Notification[]
  aiPrompts         AiPrompt[]
  aiCompetitors     AiCompetitor[]
  geoOpportunities  GeoOpportunity[]
  citationOpps      CitationOpportunity[]
  entityNodes       EntityNode[]
  redditOpps        RedditOpportunity[]
  xOpps             XOpportunity[]
  weeklyAiAudits    WeeklyAiAudit[]
  aiPromptRuns      AiPromptRun[]
  googleConnections GoogleConnection[]
  gscProperties     GscProperty[]
  ga4Properties     Ga4Property[]
  publishingConnections PublishingConnection[]

  @@unique([orgId, url])
}

// ─────────────────────── Integrations & secrets ───────────────────────

enum IntegrationKind {
  GSC
  GA4
  CMS
  LLM
}

enum IntegrationStatus {
  PENDING
  ACTIVE
  ERROR
  REVOKED
}

/// Secrets are AES-256-GCM encrypted; plaintext never touches a column.
model Integration {
  id           String            @id @default(cuid())
  websiteId    String
  kind         IntegrationKind
  provider     String
  externalId   String?
  config       Json              @default("{}")
  secretCipher Bytes?
  secretIv     Bytes?
  secretTag    Bytes?
  status       IntegrationStatus @default(PENDING)
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime          @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, kind, provider])
}

// ─────────────────────── Search Console time series ───────────────────────

model GscDaily {
  websiteId   String
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  dataState   String   @default("final")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([websiteId, date])
}

model GscQueryDaily {
  id          BigInt   @id @default(autoincrement())
  websiteId   String
  date        DateTime @db.Date
  query       String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date, query])
  @@index([websiteId, query, date])
  @@index([websiteId, date, impressions(sort: Desc)])
}

model GscPageDaily {
  id          BigInt   @id @default(autoincrement())
  websiteId   String
  date        DateTime @db.Date
  page        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date, page])
  @@index([websiteId, page, date])
}

/// Query + page grain: which PAGE serves which QUERY. Without this, an
/// opportunity knows the keyword but not the URL to fix.
model GscQueryPageDaily {
  id          BigInt   @id @default(autoincrement())
  websiteId   String
  date        DateTime @db.Date
  query       String
  page        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date, query, page])
  @@index([websiteId, query, date])
  @@index([websiteId, page, date])
}

/// country / device / searchAppearance, one table via a `dimension` discriminator.
model GscDimensionDaily {
  id          BigInt   @id @default(autoincrement())
  websiteId   String
  date        DateTime @db.Date
  dimension   String
  value       String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date, dimension, value])
  @@index([websiteId, dimension, date])
}

/// Tracks incremental sync so we never re-request data we already hold.
model SyncCursor {
  websiteId        String
  dataset          String
  lastCompleteDate DateTime? @db.Date
  lastRunAt        DateTime?
  lastStatus       String?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([websiteId, dataset])
}

// ─────────────────────── Derived intelligence ───────────────────────

enum Intent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
  LOCAL
}

enum Trend {
  UP
  FLAT
  DOWN
  NEW
  LOST
}

model Keyword {
  id               String   @id @default(cuid())
  websiteId        String
  query            String
  intent           Intent?
  intentConfidence Float?
  clusterId        String?
  bestPage         String?
  clicks28         Int      @default(0)
  impressions28    Int      @default(0)
  ctr28            Float    @default(0)
  position28       Float?
  clicksPrev28     Int      @default(0)
  positionPrev28   Float?
  trend            Trend    @default(FLAT)
  opportunityScore Float    @default(0)
  isCustom         Boolean  @default(false)
  tags             String[] @default([])
  targetUrl        String?
  targetPosition   Int?
  liveRank         Float?
  liveRankUrl      String?
  lastCheckedAt    DateTime?
  serpData         Json?
  updatedAt        DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, query])
  @@index([websiteId, opportunityScore(sort: Desc)])
  @@index([websiteId, isCustom])
}

enum PageStatus {
  HEALTHY
  OPTIMIZE
  REFRESH
  EXPAND
  SUPPORTING
  REDIRECT
  INVESTIGATE
  CANNIBALIZATION
}

model PageRecord {
  id                 String     @id @default(cuid())
  websiteId          String
  url                String
  title              String?
  metaDescription    String?
  h1                 String?
  wordCount          Int?
  lastCrawledAt      DateTime?
  lastModifiedAt     DateTime?
  indexState         String?
  canonical          String?
  isOrphan           Boolean    @default(false)
  contentScore       Int?
  contentScoreDetail Json?
  status             PageStatus @default(HEALTHY)

  website Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  content Content[]

  @@unique([websiteId, url])
}

// ─────────────────────── Content lifecycle ───────────────────────

enum ContentType {
  ARTICLE
  FAQ
  META_TITLE
  META_DESCRIPTION
  SCHEMA
  INTERNAL_LINK
  PRODUCT_COPY
}

enum ContentStatus {
  DRAFT
  QA_FAILED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHING
  PUBLISHED
  FAILED
}

model Content {
  id                String        @id @default(cuid())
  websiteId         String
  pageId            String?
  type              ContentType
  title             String
  slug              String?
  primaryKeyword    String?
  secondaryKeywords String[]      @default([])
  intent            Intent?
  brief             Json?
  body              String?
  faq               Json?
  schemaJson        Json?
  status            ContentStatus @default(DRAFT)
  qaReport          Json?
  authorAgent       String?
  cmsExternalId     String?
  publishedUrl      String?
  createdAt         DateTime      @default(now())
  publishedAt       DateTime?

  website     Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  page        PageRecord?         @relation(fields: [pageId], references: [id], onDelete: SetNull)
  versions    ContentVersion[]
  experiments ContentExperiment[]

  @@index([websiteId, status])
}

/// Every automated change is versioned, which is what makes rollback possible.
model ContentVersion {
  id          String   @id @default(cuid())
  contentId   String
  version     Int
  body        String
  diffSummary String?
  createdBy   String
  createdAt   DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
}

// ─────────────────────── Opportunities & issues ───────────────────────

enum OpportunityType {
  QUICK_WIN
  PAGE_TWO
  CTR_GAP
  DECLINING_KEYWORD
  DECLINING_PAGE
  CONTENT_DECAY
  CONTENT_GAP
  CANNIBALIZATION
  INTERNAL_LINK
  SCHEMA_MISSING
  AEO_GAP
  TECHNICAL
}

enum OppStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  DONE
  DISMISSED
  EXPIRED
}

model Opportunity {
  id String @id @default(cuid())

  websiteId String
  type      OpportunityType
  targetUrl String?
  keyword   String?
  priority  Int
  score     Float
  /// Modelled, not measured. Null when the site lacks click history to fit a CTR curve.
  estimatedClicks Float?
  /// Human-readable explanation rendered in the UI.
  why       String
  /// Only measured numbers belong here.
  evidence       Json
  recommendation Json
  status         OppStatus @default(OPEN)
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, status, score(sort: Desc)])
  @@index([websiteId, type])
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

model SeoIssue {
  id         String   @id @default(cuid())
  websiteId  String
  category   String
  severity   Severity
  title      String
  detail     Json
  url        String?
  status     String   @default("open")
  detectedAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, category, status])
}

model HealthScoreSnapshot {
  id        String   @id @default(cuid())
  websiteId String
  date      DateTime @db.Date
  total     Int
  breakdown Json

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date])
}

model InternalLinkSuggestion {
  id         String    @id @default(cuid())
  websiteId  String
  sourceUrl  String
  targetUrl  String
  anchor     String
  reason     String
  confidence Float
  status     String    @default("suggested")
  appliedAt  DateTime?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, sourceUrl, targetUrl, anchor])
}

// ─────────────────────── Agents, automation, approvals ───────────────────────

enum TaskState {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

model AgentTask {
  id         String    @id @default(cuid())
  websiteId  String
  agent      String
  kind       String
  input      Json
  output     Json?
  state      TaskState @default(QUEUED)
  parentId   String?
  runId      String?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, state, createdAt])
}

model AgentLog {
  id        BigInt   @id @default(autoincrement())
  websiteId String
  taskId    String?
  agent     String
  level     String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt(sort: Desc)])
}

model AutomationRule {
  id        String    @id @default(cuid())
  websiteId String
  name      String
  kind      String
  enabled   Boolean   @default(false)
  schedule  String
  config    Json      @default("{}")
  lastRunAt DateTime?
  nextRunAt DateTime?

  website Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  runs    AutomationRun[]
}

model AutomationRun {
  id         String    @id @default(cuid())
  ruleId     String
  websiteId  String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String
  summary    Json?
  taskIds    String[]  @default([])

  rule    AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  website Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

/// Destructive actions always create one of these, at every automation level.
model Approval {
  id          String    @id @default(cuid())
  websiteId   String
  entityType  String
  entityId    String
  action      String
  riskLevel   Severity
  payload     Json
  diff        Json?
  status      String    @default("pending")
  requestedBy String
  decidedById String?
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, status])
}

// ─────────────────────── Learning loop ───────────────────────

/// One measured change: baseline captured at apply time, outcome measured later.
model ContentExperiment {
  id         String    @id @default(cuid())
  websiteId  String
  contentId  String?
  url        String
  changeType String
  appliedAt  DateTime
  baseline   Json
  measured14 Json?
  measured28 Json?
  outcome    String?
  attributes Json      @default("{}")

  website Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([websiteId, appliedAt])
}

/// Aggregated learning; `weight` is clamped 0.7..1.4 so one lucky post can't dominate.
model LearningSignal {
  id         String   @id @default(cuid())
  websiteId  String
  signal     String
  metric     String
  delta      Float
  sampleSize Int
  confidence Float
  weight     Float    @default(1.0)
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, signal, metric])
}

model Notification {
  id        String   @id @default(cuid())
  websiteId String
  type      String
  severity  Severity
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, readAt])
}

// ─────────────────────── AI Visibility Module ───────────────────────

model AiPrompt {
  id        String   @id @default(cuid())
  websiteId String
  text      String
  country   String?
  language  String   @default("en")
  location  String?
  industry  String?
  intent    String?
  priority  Int      @default(2)
  status    String   @default("active")
  source    String   @default("manual")
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website      Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  runs         AiPromptRun[]
  geoOpps      GeoOpportunity[]
  auditResults WeeklyAiAuditResult[]

  @@unique([websiteId, text])
  @@index([websiteId, status])
}

model AiPromptRun {
  id                   String   @id @default(cuid())
  promptId             String
  websiteId            String
  engine               String
  runAt                DateTime @default(now())
  response             String?
  brandMentioned       Boolean?
  brandPosition        Int?
  citationFound        Boolean?
  citationUrl          String?
  citationDomain       String?
  competitorsMentioned String[] @default([])
  sourceDomains        String[] @default([])
  mentionContext       String?
  sentiment            String?
  confidence           Float    @default(1.0)
  collectionMethod     String   @default("api")
  errorMessage         String?

  prompt  AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  website Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([promptId, runAt(sort: Desc)])
  @@index([websiteId, engine, runAt(sort: Desc)])
}

model AiCompetitor {
  id        String   @id @default(cuid())
  websiteId String
  name      String
  domain    String
  addedAt   DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, domain])
}

model GeoOpportunity {
  id             String   @id @default(cuid())
  websiteId      String
  promptId       String?
  engine         String?
  gapType        String
  title          String
  description    String
  recommendation String
  priority       Int      @default(2)
  status         String   @default("open")
  detectedAt     DateTime @default(now())

  website Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  prompt  AiPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)

  @@index([websiteId, status])
}

model CitationOpportunity {
  id             String   @id @default(cuid())
  websiteId      String
  targetDomain   String
  targetUrl      String?
  whyRelevant    String
  authorityNotes String?
  action         String
  status         String   @default("identified")
  detectedAt     DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, status])
}

model EntityNode {
  id          String   @id @default(cuid())
  websiteId   String
  name        String
  type        String
  description String?
  pageUrl     String?
  schemaType  String?
  confidence  Float    @default(1.0)
  createdAt   DateTime @default(now())

  website       Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  relationships EntityRelationship[] @relation("EntitySource")
  targets       EntityRelationship[] @relation("EntityTarget")

  @@unique([websiteId, name, type])
}

model EntityRelationship {
  id           String @id @default(cuid())
  sourceId     String
  targetId     String
  relationship String
  confidence   Float  @default(1.0)

  source EntityNode @relation("EntitySource", fields: [sourceId], references: [id], onDelete: Cascade)
  target EntityNode @relation("EntityTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationship])
}

model RedditOpportunity {
  id            String    @id @default(cuid())
  websiteId     String
  subreddit     String
  postUrl       String
  postTitle     String
  question      String?
  topic         String?
  relevance     String    @default("relevant")
  engagement    Int       @default(0)
  postedAt      DateTime?
  detectedAt    DateTime  @default(now())
  status        String    @default("new")
  draftResponse String?
  approvedAt    DateTime?
  postedUrl     String?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, postUrl])
  @@index([websiteId, status])
}

model XOpportunity {
  id              String   @id @default(cuid())
  websiteId       String
  creatorHandle   String
  postUrl         String?
  topic           String
  relevance       String   @default("relevant")
  audienceNotes   String?
  whyRelevant     String?
  suggestedAction String?
  draftContent    String?
  status          String   @default("new")
  detectedAt      DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, status])
}

model WeeklyAiAudit {
  id             String   @id @default(cuid())
  websiteId      String
  weekStart      DateTime @db.Date
  weekEnd        DateTime @db.Date
  promptsTested  Int      @default(0)
  mentionsTotal  Int      @default(0)
  citationsTotal Int      @default(0)
  newMentions    Int      @default(0)
  lostMentions   Int      @default(0)
  newCitations   Int      @default(0)
  lostCitations  Int      @default(0)
  opportunities  Int      @default(0)
  summary        Json?
  createdAt      DateTime @default(now())

  website Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  results WeeklyAiAuditResult[]

  @@unique([websiteId, weekStart])
  @@index([websiteId, weekStart(sort: Desc)])
}

model WeeklyAiAuditResult {
  id             String   @id @default(cuid())
  auditId        String
  promptId       String
  engine         String
  brandMentioned Boolean?
  citationFound  Boolean?
  prevMentioned  Boolean?
  prevCitation   Boolean?
  changed        Boolean  @default(false)

  audit  WeeklyAiAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  prompt AiPrompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ─────────────────────── Direct Google & Publishing Architecture ───────────────────────

model GoogleConnection {
  id                    String    @id @default(cuid())
  websiteId             String
  email                 String?
  encryptedAccessToken  Bytes?
  encryptedRefreshToken Bytes?
  tokenIv               Bytes?
  tokenTag              Bytes?
  tokenExpiresAt        DateTime?
  scopes                String[]  @default([])
  status                String    @default("connected") // connected | expired | revoked | error
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  website       Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  gscProperties GscProperty[]
  ga4Properties Ga4Property[]

  @@index([websiteId, status])
}

model GscProperty {
  id                 String    @id @default(cuid())
  websiteId          String
  googleConnectionId String
  propertyUrl        String
  propertyType       String    @default("URL_PREFIX") // URL_PREFIX | DOMAIN
  permissionLevel    String?
  isSelected         Boolean   @default(false)
  lastSyncAt         DateTime?
  status             String    @default("active")

  website          Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  googleConnection GoogleConnection @relation(fields: [googleConnectionId], references: [id], onDelete: Cascade)

  @@unique([websiteId, propertyUrl])
}

model Ga4Property {
  id                 String    @id @default(cuid())
  websiteId          String
  googleConnectionId String
  accountId          String?
  propertyId         String
  propertyName       String?
  isSelected         Boolean   @default(false)
  lastSyncAt         DateTime?
  status             String    @default("active")

  website          Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  googleConnection GoogleConnection @relation(fields: [googleConnectionId], references: [id], onDelete: Cascade)

  @@unique([websiteId, propertyId])
}

model PublishingConnection {
  id              String    @id @default(cuid())
  websiteId       String
  type            String    // WORDPRESS | SHOPIFY | GITHUB | WEBHOOK | MANUAL
  config          Json      @default("{}")
  encryptedSecret Bytes?
  secretIv        Bytes?
  secretTag       Bytes?
  status          String    @default("active")
  lastPublishedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, type])
}

// ─────────────────────── System Settings ───────────────────────

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}


